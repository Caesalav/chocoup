# Copia este archivo como .env.local y pega las claves del proyecto de Supabase.
# Están en el panel: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Opcional. Sin esto los enlaces del correo de acceso apuntan al host de la
# petición, que es lo correcto en local y en Vercel.
# NEXT_PUBLIC_SITE_URL=https://chocoup.org
