# Copia este archivo como .env.local y pega las claves del proyecto de Supabase.
# Están en el panel: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Opcional. Sin esto los enlaces del correo de acceso apuntan al host de la
# petición, que es lo correcto en local y en Vercel.
# NEXT_PUBLIC_SITE_URL=https://chocoup.org

# El portal nace cerrado: quien llega ve la landing, no el tablero.
# Poner 1 abre el portal entero (local, o el día del lanzamiento).
# SITE_OPEN=1

# Opcional. Quien visite /?abrir=esta-frase entra al tablero sin ser del equipo.
# La landing también abre con la clave HolaMundo, en el punto discreto.
# SITE_PREVIEW_SECRET=una-frase-larga

# La llave de servicio de Supabase, en Project Settings -> API. Se salta todas
# las RLS, así que NO lleva el prefijo NEXT_PUBLIC_ y no puede llevarlo: es la
# única credencial con la que se puede escribir un importe de donación, y solo
# la usa el webhook de pagos. Ver lib/supabase/admin.ts.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Mercado Pago. Access token de producción (o de prueba) del panel de
# desarrolladores. Sin esto, Donar no puede abrir el cobro.
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxx

# La «clave secreta» del webhook: en el panel de Mercado Pago, Tus
# integraciones -> la aplicación -> Webhooks, al configurar la URL
# https://<el dominio>/api/mercadopago/webhook para el evento «Pagos».
#
# Sin esto el portal COBRA pero no registra ninguna donación: el webhook
# rechaza todo aviso que no venga firmado, porque la URL es pública y sin
# firma cualquiera podría escribir en el registro de donaciones. La barra de
# recaudado de cada causa se queda en cero aunque la gente done.
# MP_WEBHOOK_SECRET=xxxxxxxx

# Correo. La clave de Resend, del panel: https://resend.com/api-keys
#
# Sin esto el portal cobra y registra la donación, pero no sale ningún correo:
# ni el agradecimiento a quien donó ni el aviso al equipo. Se queda escrito en
# el registro del servidor y no se reintenta solo.
# RESEND_API_KEY=re_xxxxxxxx

# El remitente. El dominio tiene que estar verificado en Resend o la API
# rechaza el envío. Por omisión, ChocóUp <comunidad@chocoup.org>.
# EMAIL_FROM=ChocóUp <comunidad@chocoup.org>

# A dónde va la respuesta cuando alguien contesta al agradecimiento. Es otra
# variable porque no es el remitente: el de arriba es un buzón de envío y esto
# es la persona que responde. Por omisión, charlie@browwwn.com.
# EMAIL_REPLY_TO=charlie@browwwn.com

# A quién se avisa cada vez que entra una donación, con quién donó, cuánto y a
# qué causa. Por omisión, charlie@browwwn.com.
# DONATION_ALERT_EMAIL=alguien@ejemplo.com
